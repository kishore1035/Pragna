# Use http://localhost:11434 for local Ollama, or https://api.ollama.com when using Ollama Cloud API keys
OLLAMA_URL=https://api.ollama.com
CHAT_MODEL=gemma4:cloud
EMBED_MODEL=nomic-embed-text
RAG_SIMILARITY_THRESHOLD=0.5
DB_PATH=data/mimir.db
DOCUMENTS_DIR=data/documents

# Optional: Ollama API key(s) for Ollama Cloud or external proxies.
# Supports a single key (OLLAMA_API_KEY), a comma-separated list (OLLAMA_API_KEYS),
# or numbered slots (OLLAMA_API_KEY_1 through OLLAMA_API_KEY_9) with automatic round-robin & failover.
OLLAMA_API_KEY=
OLLAMA_API_KEYS=
OLLAMA_API_KEY_1=
OLLAMA_API_KEY_2=
OLLAMA_API_KEY_3=
OLLAMA_API_KEY_4=
OLLAMA_API_KEY_5=
OLLAMA_API_KEY_6=
OLLAMA_API_KEY_7=
OLLAMA_API_KEY_8=
OLLAMA_API_KEY_9=

# Optional: Brave Search API key for web_search (falls back to a DuckDuckGo
# HTML scrape if absent).
BRAVE_SEARCH_API_KEY=

# Required for the generate_image/edit_image tools. Get a key at
# https://platform.stability.ai/account/keys -- without it, those tools
# return a clear error instead of failing silently.
STABILITY_API_KEY=

# Required: secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional: enables "Continue with Google" / "Continue with GitHub" on the
# login screen. Without these, email/password auth still works fine.
#
# Google: https://console.cloud.google.com/ -> APIs & Services -> Credentials
#   -> Create OAuth client ID -> Web application
#   -> Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers -> New OAuth App
#   -> Homepage URL: http://localhost:4028
#   -> Authorization callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
